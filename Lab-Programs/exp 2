#include <stdio.h>

int main()
{
    int n, i, num;

    printf("Enter number of elements: ");
    scanf("%d",&n);

    printf("Enter numbers:\n");

    for(i=1;i<=n;i++)
    {
        scanf("%d",&num);

        if(num%2==0)
            printf("%d is Even\n",num);
        else
            printf("%d is Odd\n",num);
    }

    return 0;
}
